---
interface Experiencia {
  puesto: string;
  empresa: string;
  periodo: string;
  descripcion: string;
  logros: string[];
}

interface Props {
  items: Experiencia[];
}

const { items } = Astro.props;
---

<ol class="relative mx-auto max-w-2xl space-y-9 border-l border-light/10 pl-6 sm:pl-8">
  {
    items.map((item) => (
      <li class="relative">
        <span
          class="absolute top-1.5 -left-[1.625rem] size-2.5 rounded-full bg-accent ring-4 ring-navy sm:-left-[2.125rem]"
          aria-hidden="true"
        />
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <h3 class="font-semibold text-light">{item.puesto}</h3>
          <span class="text-xs font-medium tracking-wider text-light/45 uppercase">
            {item.periodo}
          </span>
        </div>
        <p class="mt-0.5 text-sm font-medium text-accent/90">{item.empresa}</p>
        <p class="mt-2 text-sm leading-relaxed text-light/65">
          {item.descripcion}
        </p>
        {item.logros.length > 0 && (
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-relaxed text-light/55">
            {item.logros.map((logro) => (
              <li>{logro}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>
