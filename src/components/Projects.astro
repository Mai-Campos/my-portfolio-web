---
import { Icon } from 'astro-icon/components';

interface Proyecto {
  nombre: string;
  descripcion: string;
  stack: string[];
  demo?: string;
  repo?: string;
}

interface Props {
  items: Proyecto[];
}

const { items } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2">
  {
    items.map((project) => (
      <article class="group flex flex-col rounded-2xl border border-light/10 bg-surface/40 p-6 transition duration-300 hover:-translate-y-0.5 hover:border-accent/50 hover:bg-surface/60">
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-semibold text-light">{project.nombre}</h3>
          <div class="flex shrink-0 items-center gap-2">
            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-light/50 transition hover:text-accent"
                aria-label={`Ver demo de ${project.nombre}`}
              >
                <Icon name="lucide:arrow-up-right" class="size-4" aria-hidden="true" />
              </a>
            )}
            {project.repo && (
              <a
                href={project.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-light/50 transition hover:text-accent"
                aria-label={`Ver repositorio de ${project.nombre}`}
              >
                <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
              </a>
            )}
          </div>
        </div>

        <p class="mt-3 flex-1 text-sm leading-relaxed text-light/65">
          {project.descripcion}
        </p>

        {project.stack.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.stack.map((tech) => (
              <li class="rounded-full border border-light/10 px-2.5 py-0.5 text-[11px] text-light/60">
                {tech}
              </li>
            ))}
          </ul>
        )}
      </article>
    ))
  }
</div>
