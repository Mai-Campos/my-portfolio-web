---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import type { Dictionary } from '../i18n/ui';

interface Proyecto {
  nombre: string;
  descripcion: string;
  stack: string[];
  imagen?: ImageMetadata;
  imagenAlt?: string;
  demo?: string;
  repo?: string;
}

interface Props {
  items: Proyecto[];
  labels: Dictionary;
}

const { items, labels } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2">
  {
    items.map((project) => (
      <article class="group flex flex-col overflow-hidden rounded-2xl border border-light/10 bg-surface/40 transition duration-300 hover:-translate-y-0.5 hover:border-accent/50 hover:bg-surface/60">
        {project.imagen && (
          <div class="aspect-video overflow-hidden border-b border-light/10 bg-navy">
            <Image
              src={project.imagen}
              alt={project.imagenAlt ?? project.nombre}
              widths={[480, 960]}
              sizes="(min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>
        )}

        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-semibold text-light">{project.nombre}</h3>
            <div class="flex shrink-0 items-center gap-2">
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-light/50 transition hover:text-accent"
                  aria-label={labels.demo(project.nombre)}
                >
                  <Icon
                    name="lucide:arrow-up-right"
                    class="size-4"
                    aria-hidden="true"
                  />
                </a>
              )}
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-light/50 transition hover:text-accent"
                  aria-label={labels.repo(project.nombre)}
                >
                  <Icon
                    name="simple-icons:github"
                    class="size-4"
                    aria-hidden="true"
                  />
                </a>
              )}
            </div>
          </div>

          <p class="mt-3 flex-1 text-sm leading-relaxed text-light/65">
            {project.descripcion}
          </p>

          {project.stack.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <li class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
                  {tech}
                </li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))
  }
</div>
