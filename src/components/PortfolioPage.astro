---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Section from './Section.astro';
import Divider from './Divider.astro';
import TechMarquee from './TechMarquee.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Education from './Education.astro';
import SoftSkills from './SoftSkills.astro';
import Footer from './Footer.astro';
import { ui } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const p = entry.data;
const lang = p.lang;
const labels = ui[lang];

type SectionId =
  | 'sobre-mi'
  | 'tecnologias'
  | 'experiencia'
  | 'proyectos'
  | 'educacion'
  | 'habilidades';

const sectionsById = new Map(p.secciones.map((section) => [section.id, section]));

function section(id: SectionId) {
  const data = sectionsById.get(id);

  if (!data) {
    throw new Error(`Falta la sección "${id}" en el contenido de ${lang}`);
  }

  return { id: data.id, title: data.titulo, subtitle: data.subtitulo };
}

const title = `${p.nombre} — ${p.cargo}`;
const description = labels.description(p.nombre, p.cargo);
---

<BaseLayout title={title} description={description} lang={lang}>
  <main class="mx-auto w-full max-w-3xl px-5 sm:px-8">
    <Header
      nombre={p.nombre}
      cargo={p.cargo}
      email={p.email}
      cv={p.cv}
      github={p.github}
      linkedin={p.linkedin}
      avatarSeed={p.avatarSeed}
      lang={lang}
      labels={labels}
    />

    <div class="space-y-16 pb-20 sm:space-y-20 sm:pb-24">
      <Section {...section('sobre-mi')}>
        <div class="prose-portfolio mx-auto max-w-2xl text-center">
          <Content />
        </div>
      </Section>

      <Divider />

      <Section {...section('tecnologias')}>
        <TechMarquee tecnologias={p.tecnologias} />
      </Section>

      <Section {...section('experiencia')}>
        <Experience items={p.experiencia} />
      </Section>

      <Section {...section('proyectos')}>
        <Projects items={p.proyectos} labels={labels} />
      </Section>

      <Section {...section('educacion')}>
        <Education items={p.educacion} />
      </Section>

      <Section {...section('habilidades')}>
        <SoftSkills items={p.habilidades} />
      </Section>
    </div>
  </main>

  <Footer
    nombre={p.nombre}
    email={p.email}
    cv={p.cv}
    github={p.github}
    linkedin={p.linkedin}
    labels={labels}
  />
</BaseLayout>
