---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<section id={id} class="scroll-mt-20">
  <div class="mb-10 text-center">
    <span class="mx-auto mb-4 block h-px w-10 bg-accent" aria-hidden="true"
    ></span>
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
    {
      subtitle && (
        <p class="mx-auto mt-2 max-w-xl text-sm text-light/55">{subtitle}</p>
      )
    }
  </div>
  <slot />
</section>
