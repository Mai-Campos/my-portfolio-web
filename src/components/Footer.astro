---
interface Props {
  nombre: string;
  email: string;
  cv: string;
  github: string;
  linkedin: string;
}

const { nombre, email, cv, github, linkedin } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-light/10">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-4 px-5 py-8 text-center text-xs text-light/45 sm:px-8"
  >
    <p class="text-sm font-semibold text-light/70">{nombre}</p>

    <nav
      class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2"
      aria-label="Enlaces del footer"
    >
      <a href={`mailto:${email}`} class="transition hover:text-accent">Email</a>
      <span class="text-light/20" aria-hidden="true">·</span>
      <a href={cv} download class="transition hover:text-accent">CV</a>
      <span class="text-light/20" aria-hidden="true">·</span>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-accent">GitHub</a
      >
      <span class="text-light/20" aria-hidden="true">·</span>
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-accent">LinkedIn</a
      >
    </nav>

    <p>
      © {year} {nombre}. Hecho con Astro y Tailwind CSS.
    </p>
  </div>
</footer>
