---
interface Educacion {
  titulo: string;
  institucion: string;
  periodo: string;
  descripcion?: string;
}

interface Props {
  items: Educacion[];
}

const { items } = Astro.props;
---

<div class="mx-auto grid max-w-2xl gap-4 sm:grid-cols-2">
  {
    items.map((item) => (
      <article class="rounded-2xl border border-light/10 bg-surface/40 p-6">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="font-semibold text-light">{item.titulo}</h3>
          <span class="shrink-0 text-xs font-medium tracking-wider text-light/45 uppercase">
            {item.periodo}
          </span>
        </div>
        <p class="mt-0.5 text-sm font-medium text-accent/90">
          {item.institucion}
        </p>
        {item.descripcion && (
          <p class="mt-3 text-sm leading-relaxed text-light/65">
            {item.descripcion}
          </p>
        )}
      </article>
    ))
  }
</div>
