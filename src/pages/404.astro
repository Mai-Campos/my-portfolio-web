---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="404 — Maikol Campos Rodríguez"
  description="Página no encontrada. Page not found."
  lang="es"
>
  <main class="flex min-h-dvh flex-col items-center justify-center px-6 text-center">
    <p class="text-sm font-semibold tracking-[0.3em] text-accent">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-5xl">
      Página no encontrada
    </h1>
    <p class="mt-2 text-base text-light/65">Page not found</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={base}
        class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-navy transition hover:bg-accent/90"
      >
        Volver al inicio
      </a>
      <a
        href={`${base}en/`}
        class="rounded-full border border-light/20 px-5 py-2.5 text-sm font-semibold text-light/85 transition hover:border-accent/60 hover:text-accent"
      >
        Back home
      </a>
    </div>
  </main>
</BaseLayout>
